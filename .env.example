DATABASE_URL="postgresql://user:password@localhost:5432/fdm"
DIRECT_URL="postgresql://user:password@localhost:5432/fdm"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord OAuth ONLY. The bot token, guild id, role and channel ids moved to
# discord-bot-gateway, which is now the only service that can post to the
# community or assign the Founder role.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# discord-bot-gateway. GATEWAY_TOKEN is one shared secret used in BOTH
# directions — this app sends it when calling the gateway, and the gateway
# sends it back when calling GET /api/internal/recipients — so it must be
# byte-identical on both sides. Generate with: openssl rand -hex 32
GATEWAY_TOKEN=
# Service name on fydemy-internal. The gateway has no public hostname.
GATEWAY_BASE_URL="http://gateway:8080"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Fydemy <onboarding@resend.dev>"
# Optional — CC'd on every transactional email
RESEND_CC_EMAIL=""

# Supabase Storage (file uploads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Google Analytics 4 measurement ID (optional — omit to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
